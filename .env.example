# Local services: `docker compose up -d` (Postgres on 5433, SeaweedFS S3 on 8333).
DATABASE_URL="postgresql://clone:clone@localhost:5433/clone"

# S3-compatible storage. SeaweedFS locally; Cloudflare R2 or AWS S3 in production.
# Render providers fetch reference images from signed URLs, so production storage must be public-reachable.
S3_ENDPOINT="http://localhost:8333"
S3_REGION="auto"
S3_ACCESS_KEY_ID="clone"
S3_SECRET_ACCESS_KEY="clone-secret"
NEXT_PUBLIC_IMAGES_BUCKET_NAME="clone-media"

# Text, vision, and video-understanding models (Opus, Gemini): https://api.surplusintelligence.ai
SURPLUS_API_KEY=""

# Who renders takes: kie (default), revana, or sume. Only the chosen provider's key is needed.
VIDEO_PROVIDER="kie"
KIE_API_KEY=""
REVANA_API_KEY=""
SUME_API_KEY=""

# Public URL of this app. KIE and Sume POST finished renders to <SITE_URL>/api/waitpoints/<id>,
# so in development expose it with a tunnel (e.g. `cloudflared tunnel --url http://localhost:3000`).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
