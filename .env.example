# Local services: `docker compose up -d` (Postgres on 5433, SeaweedFS S3 on 8333).
DATABASE_URL="postgresql://clone:clone@localhost:5433/clone"

# S3-compatible storage. SeaweedFS locally; Cloudflare R2 or AWS S3 in production.
# Render providers fetch reference images from signed URLs, so set S3_PUBLIC_ENDPOINT if internal S3_ENDPOINT differs.
S3_ENDPOINT="http://localhost:8333"
S3_PUBLIC_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID="clone"
S3_SECRET_ACCESS_KEY="clone-secret"
S3_BUCKET="clone-media"

# Public URL of this app evaluated at runtime (waitpoint callbacks POST to <SITE_URL>/api/waitpoints/<id>).
SITE_URL="http://localhost:3000"

# --- AI Plane 1: Video Understanding (analysis + render verification) ---
# Optional explicit selection: gemini | openrouter | surplus. Auto-detects from configured keys if omitted.
VIDEO_ANALYSIS_PROVIDER=""
VIDEO_ANALYSIS_MODEL=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# --- AI Plane 2: Text & Vision Structured Outputs (rewriting + prompt adaptation) ---
# Optional explicit selection: anthropic | openai | openrouter | gemini | surplus. Auto-detects from configured keys if omitted.
TEXT_PROVIDER=""
TEXT_MODEL=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENAI_BASE_URL=""

# Optional unified gateway for both AI planes (never required if direct provider keys are set).
SURPLUS_API_KEY=""

# --- Video Generation Provider ---
# Select active video vendor: kie | revana | sume (or custom registered plugin id).
VIDEO_PROVIDER="kie"
KIE_API_KEY=""
REVANA_API_KEY=""
SUME_API_KEY=""
