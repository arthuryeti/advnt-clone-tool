# ==============================================================================
# Video Clone — Runtime Configuration (BYOK)
# ==============================================================================
# Minimum 2-key setup:
#   1. GEMINI_API_KEY (automatically powers BOTH video analysis and text rewriting)
#   2. One video generation key: FAL_API_KEY | KIE_API_KEY | REVANA_API_KEY | SUME_API_KEY
#      (REVANA_API_KEY uses polling and works locally with zero webhook tunnels.)
#
# All values are read at runtime — never baked into the Docker image.
# ==============================================================================

# --- Database (Postgres) ---
# For local dev with `docker compose up -d`:
DATABASE_URL="postgresql://clone:clone@localhost:5433/clone"
# Optional host port overrides if 5433 / 8333 / 3000 are already occupied:
# POSTGRES_PORT=5433
# S3_PORT=8333
# APP_PORT=3000
# Set AUTO_MIGRATE="false" in container deployments only if you run migrations externally:
# AUTO_MIGRATE="true"

# --- S3-Compatible Storage ---
# SeaweedFS locally (`docker compose up -d`); Cloudflare R2, AWS S3, or Tigris in production.
# Remote video generators fetch reference images via signed URLs from S3_PUBLIC_ENDPOINT.
S3_ENDPOINT="http://localhost:8333"
S3_PUBLIC_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID="clone"
S3_SECRET_ACCESS_KEY="clone-secret"
S3_BUCKET="clone-media"

# --- Public App URL (evaluated at runtime) ---
# Webhook providers (kie, fal, sume) POST finished renders to <SITE_URL>/api/waitpoints/<id>.
# In production set this to your HTTPS domain. In local dev, use a tunnel (e.g. cloudflared)
# or switch VIDEO_PROVIDER="revana" (polling, no public SITE_URL required).
SITE_URL="http://localhost:3000"
# Allow local/private SITE_URL and S3_PUBLIC_ENDPOINT during `npm run doctor` / `/api/preflight`:
# PREFLIGHT_ALLOW_LOCAL_URLS="true"

# --- AI Plane 1: Video Understanding (analysis + render verification) ---
# Optional explicit selection: gemini | openrouter | surplus.
# If omitted, auto-selects the first configured key in that order.
VIDEO_ANALYSIS_PROVIDER=""
VIDEO_ANALYSIS_MODEL=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# --- AI Plane 2: Text & Structured Outputs (rewriting + prompt adaptation) ---
# Optional explicit selection: anthropic | openai | openrouter | gemini | surplus.
# If omitted, auto-selects the first configured key in that order (GEMINI_API_KEY works for both planes).
TEXT_PROVIDER=""
TEXT_MODEL=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Point OPENAI_BASE_URL at any OpenAI-compatible endpoint (OpenRouter, Groq, Together, vLLM, etc.):
OPENAI_BASE_URL=""

# Optional unified gateway covering both Video Understanding and Text planes:
SURPLUS_API_KEY=""

# --- AI Plane 3: Video Generation ---
# Active vendor: kie | revana | sume | fal (or any custom adapter registered in lib/ai/providers/video/registry.ts).
VIDEO_PROVIDER="kie"
KIE_API_KEY=""
FAL_API_KEY=""
REVANA_API_KEY=""
SUME_API_KEY=""
# Optional base URL overrides (for proxies or custom endpoints):
# KIE_BASE_URL=""
# FAL_BASE_URL=""
# REVANA_BASE_URL=""
# SUME_BASE_URL=""
# GEMINI_BASE_URL=""
# ANTHROPIC_BASE_URL=""
# OPENROUTER_BASE_URL=""
