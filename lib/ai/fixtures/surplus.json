{
  "provider": "surplus",
  "baseUrl": "https://api.surplusintelligence.ai/v1",
  "authHeader": {
    "name": "Authorization",
    "prefix": "Bearer "
  },
  "chatCompletions": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "videoRequestBody": {
      "model": "gemini-3.8-flash",
      "provider": ["google", "openrouter"],
      "response_format": {
        "type": "json_schema",
        "json_schema": {
          "name": "out",
          "strict": true,
          "schema": {
            "type": "object",
            "properties": {
              "summary": { "type": "string" }
            },
            "required": ["summary"]
          }
        }
      },
      "messages": [
        {
          "role": "user",
          "content": [
            {
              "type": "image_url",
              "image_url": {
                "url": "data:video/mp4;base64,AAAA"
              }
            },
            {
              "type": "text",
              "text": "Summarize"
            }
          ]
        }
      ]
    },
    "successResponse": {
      "status": 200,
      "body": {
        "id": "chatcmpl-123",
        "choices": [
          {
            "index": 0,
            "message": {
              "role": "assistant",
              "content": "{\"summary\":\"A quick product demo\"}"
            },
            "finish_reason": "stop"
          }
        ]
      }
    },
    "wrappedNamedObjectResponse": {
      "status": 200,
      "body": {
        "id": "chatcmpl-124",
        "choices": [
          {
            "index": 0,
            "message": {
              "role": "assistant",
              "content": "{\"videoStory\":{\"summary\":\"Unwrapped object\"}}"
            },
            "finish_reason": "stop"
          }
        ]
      }
    },
    "errors": {
      "auth": {
        "status": 401,
        "body": {
          "error": {
            "code": "unauthorized",
            "message": "Invalid Surplus API key"
          }
        }
      },
      "quota": {
        "status": 402,
        "body": {
          "error": {
            "code": "payment_required",
            "message": "Insufficient balance"
          }
        }
      },
      "moderation": {
        "status": 400,
        "body": {
          "error": {
            "code": "content_policy_violation",
            "message": "Safety moderation blocked this request"
          }
        }
      },
      "rateLimited": {
        "status": 429,
        "headers": {
          "Retry-After": "1"
        },
        "body": {
          "error": {
            "code": "rate_limit_exceeded",
            "message": "Rate limit reached"
          }
        }
      },
      "noHealthySellers": {
        "status": 503,
        "body": {
          "error": {
            "code": "no_healthy_sellers",
            "message": "No healthy sellers available"
          }
        }
      }
    },
    "malformedResponse": {
      "status": 200,
      "body": {
        "choices": [
          {
            "message": {
              "content": "not-valid-json"
            }
          }
        ]
      }
    }
  },
  "preflight": {
    "method": "GET",
    "path": "/v1/models",
    "successResponse": {
      "status": 200,
      "body": {
        "data": [{ "id": "claude-opus-5.5" }, { "id": "gemini-3.8-flash" }]
      }
    },
    "authErrorResponse": {
      "status": 401,
      "body": {
        "error": {
          "message": "Invalid token"
        }
      }
    }
  }
}
