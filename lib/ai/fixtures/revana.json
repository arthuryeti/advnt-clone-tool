{
  "provider": "revana",
  "baseUrl": "https://api.revana.si/v1",
  "authHeader": {
    "name": "Authorization",
    "prefix": "Bearer "
  },
  "submit": {
    "method": "POST",
    "path": "/v1/generations",
    "headers": {
      "Idempotency-Key": "11111111-1111-4111-8111-111111111111"
    },
    "requestBody": {
      "model": "seedance-2.5",
      "input": {
        "prompt": "@image1 holds @image2.",
        "duration": 6,
        "aspect_ratio": "9:16",
        "resolution": "480p",
        "audio": true,
        "image_urls": [
          "https://cdn.example.test/creator.jpg",
          "https://cdn.example.test/product.jpg"
        ]
      }
    },
    "successResponse": {
      "status": 201,
      "body": {
        "id": "rev-gen-123",
        "status": "queued",
        "error": null
      }
    },
    "errors": {
      "auth": {
        "status": 401,
        "body": {
          "error": {
            "code": "unauthorized",
            "message": "Invalid Bearer token"
          }
        }
      },
      "quota": {
        "status": 402,
        "body": {
          "error": {
            "code": "insufficient_credits",
            "message": "Balance too low"
          }
        }
      },
      "moderation": {
        "status": 400,
        "body": {
          "error": {
            "code": "content_moderation",
            "message": "Prompt violated safety policy"
          }
        }
      },
      "invalidInput": {
        "status": 400,
        "body": {
          "error": {
            "code": "invalid_request",
            "message": "duration must be <= 30"
          }
        }
      },
      "rateLimited": {
        "status": 429,
        "headers": {
          "Retry-After": "2"
        },
        "body": {
          "error": {
            "code": "rate_limited",
            "message": "Rate limit exceeded"
          }
        }
      },
      "transient": {
        "status": 502,
        "body": {
          "error": {
            "code": "bad_gateway",
            "message": "Upstream timeout"
          }
        }
      }
    },
    "malformedResponse": {
      "status": 200,
      "body": {
        "status": "queued"
      }
    }
  },
  "poll": {
    "method": "GET",
    "path": "/v1/generations/rev-gen-123",
    "pendingResponse": {
      "status": 200,
      "body": {
        "id": "rev-gen-123",
        "status": "running",
        "error": null
      }
    },
    "successResponse": {
      "status": 200,
      "body": {
        "id": "rev-gen-123",
        "status": "succeeded",
        "error": null
      }
    },
    "failedResponse": {
      "status": 200,
      "body": {
        "id": "rev-gen-123",
        "status": "failed",
        "error": {
          "message": "Model execution failed"
        }
      }
    }
  },
  "download": {
    "method": "GET",
    "path": "/v1/generations/rev-gen-123/content",
    "redirectResponse": {
      "status": 302,
      "headers": {
        "location": "https://cdn.revana.example.test/files/rev-gen-123.mp4"
      }
    }
  },
  "preflight": {
    "method": "GET",
    "path": "/v1/balance",
    "successResponse": {
      "status": 200,
      "body": {
        "balance_usd": 12.5
      }
    },
    "authErrorResponse": {
      "status": 401,
      "body": {
        "error": {
          "message": "Invalid API key"
        }
      }
    }
  }
}
